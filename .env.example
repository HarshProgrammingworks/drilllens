# DrillLens / eRTMAC-NWIS environment
# Copy to .env and change every secret before any non-local deployment.

DATABASE_URL=postgresql+psycopg2://drilllens:drilllens@postgres:5432/drilllens
SECRET_KEY=change-me-secret-key
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REMEMBER_MINUTES=10080
UPLOAD_DIRECTORY=/app/uploads
MAX_UPLOAD_SIZE_MB=25
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANGUAGE=eng
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
WEBSOCKET_INTERVAL_SECONDS=2
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ENVIRONMENT=development
# Development only. Must be false in production. When true, forgot-password returns the reset token.
RETURN_RESET_TOKEN=true
SENSOR_ADAPTER=simulated
RISK_ENGINE=rule_based
ENABLE_SPACY=true
ENABLE_TRANSFORMERS=false
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest
APP_VERSION=1.0.0
